{
  "entity": {
    "climate": {
      "aircon": {
        "default": "mdi:air-conditioner",
        "state_attributes": {
          "preset_mode": {
            "default": "mdi:tune",
            "state": {
              "none": "mdi:circle-off-outline",
              "boost": "mdi:rocket-launch",
              "silent": "mdi:volume-off",
              "sleep": "mdi:power-sleep"
            }
          },
          "fan_mode": {
            "default": "mdi:fan",
            "state": {
              "auto": "mdi:fan-auto",
              "low": "mdi:fan-speed-1",
              "medium_low": "mdi:fan-speed-1",
              "medium": "mdi:fan-speed-2",
              "medium_high": "mdi:fan-speed-3",
              "high": "mdi:fan-speed-3"
            }
          }
        }
      }
    },
    "select": {
      "louver": {
        "default": "mdi:arrow-up-down-bold",
        "state": {
          "off": "mdi:arrow-collapse-horizontal",
          "swing": "mdi:swap-vertical-bold"
        }
      }
    },
    "switch": {
      "ioniser": {
        "default": "mdi:creation",
        "state": {
          "off": "mdi:creation-outline"
        }
      }
    },
    "binary_sensor": {
      "compressor": { "default": "mdi:engine-off", "state": { "on": "mdi:engine" } },
      "cloud_connected": { "default": "mdi:cloud-off-outline", "state": { "on": "mdi:cloud-check-outline" } }
    },
    "sensor": {
      "firmware_version": { "default": "mdi:chip" },
      "cloud_compressor_frequency": { "default": "mdi:sine-wave" },
      "cloud_compressor_runtime": { "default": "mdi:timer-outline" },
      "cloud_dc_bus_voltage": { "default": "mdi:current-dc" },
      "cloud_error_code": { "default": "mdi:alert-circle-outline" },
      "cloud_discharge_temperature": { "default": "mdi:thermometer-high" },
      "error_code": { "default": "mdi:alert-circle-outline" },
      "estimated_power": { "default": "mdi:flash-outline" },
      "estimated_energy": { "default": "mdi:lightning-bolt-outline" },
      "power": { "default": "mdi:flash" }
    }
  }
}
